rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email in [
        'aryansiddhartha03@gmail.com',
        'nirupam.gardia12@gmail.com',
        'gardianirupam@gmail.com',
        'khushbudayal6@gmail.com',
        'namboodiriveena@gmail.com',
        'pooja.jaiswal63@gmail.com',
        'Pooja.jaiswal63@gmail.com'
      ];
    }
    function isValidDepartment(dept) {
      return dept in ['Medical (Doctors & Consultants)','Nursing','Technicians & Diagnostics','Paramedical & Allied Health','Administrative & Management','Support & Facility Services','Other'];
    }
    function isValidExperience(exp) {
      return exp in ['0 Year','0 - 1 Year','1 - 3 Years','3 - 6 Years','6 - 10 Years','10+ Years'];
    }
    function isValidStatus(status) {
      return status in ['New','Shortlisted','Called','Interview Scheduled','Interviewed','Selected','Rejected','On Hold'];
    }
    function isValidImageType(type) {
      return type in ['image/jpeg','image/jpg','image/png'];
    }
    function isValidApplicationCreate() {
      return request.resource.data.keys().hasOnly(['name','phone','aboutMe','department','specificRole','customRole','workExperience','cvImageData','cvImageName','cvImageType','cvImageSize','applicationStatus','hrRemarks','submittedAt','updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 10
        && request.resource.data.phone.size() <= 15
        && request.resource.data.aboutMe is string
        && request.resource.data.aboutMe.size() <= 1000
        && isValidDepartment(request.resource.data.department)
        && request.resource.data.specificRole is string
        && request.resource.data.specificRole.size() <= 80
        && request.resource.data.customRole is string
        && request.resource.data.customRole.size() <= 80
        && isValidExperience(request.resource.data.workExperience)
        && request.resource.data.cvImageData is string
        && request.resource.data.cvImageData.size() > 1000
        && request.resource.data.cvImageData.size() <= 900000
        && request.resource.data.cvImageName is string
        && request.resource.data.cvImageName.size() <= 120
        && request.resource.data.cvImageType is string
        && isValidImageType(request.resource.data.cvImageType)
        && request.resource.data.cvImageSize is number
        && request.resource.data.cvImageSize > 0
        && request.resource.data.cvImageSize <= 700000
        && request.resource.data.applicationStatus == 'New'
        && request.resource.data.hrRemarks is string
        && request.resource.data.hrRemarks.size() <= 1000;
    }
    match /applications/{applicationId} {
      allow create: if isValidApplicationCreate();
      allow get, list: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['applicationStatus','hrRemarks','updatedAt'])
        && isValidStatus(request.resource.data.applicationStatus)
        && request.resource.data.hrRemarks is string
        && request.resource.data.hrRemarks.size() <= 1000;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
